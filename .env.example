# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# `.env` is gitignored — never commit it, and never paste your tokens anywhere.
# Every key here can also be given as an environment variable, which wins.

# ── Canvas ────────────────────────────────────────────────────────────────────
# Canvas → Account → Settings → "+ New Access Token".
CANVAS_API_TOKEN=paste_your_canvas_token_here

# Your school's Canvas domain, no trailing slash and no /api/v1.
CANVAS_BASE_URL=https://hbs.instructure.com

# ── Claude ────────────────────────────────────────────────────────────────────
# Notes are written through Claude Code (`claude -p`) on a Claude Pro/Max
# subscription by default — sign in once with `claude` on the Mac; in CI set
# CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`. No API key needed.
NOTES_BACKEND=claude-code          # or: api
NOTES_MODEL=claude-opus-5          # model for the cheat sheets
NOTES_MAX_PER_RUN=4                # cap per run; a backlog can exhaust the plan's 5-hour window
BRIEF_MODEL=claude-sonnet-5        # model for course-brief updates and the materials index

# Only for NOTES_BACKEND=api: a Console key (https://console.anthropic.com →
# Settings → API keys), billed per token. Not a claude.ai login.
#ANTHROPIC_API_KEY=sk-ant-...

# ── Where your course folders live ────────────────────────────────────────────
# Point this at the folder holding your per-course subfolders. Setting it means
# you can run the scripts straight from this clone — no second copy needed.
COURSEWORK_ROOT=~/Desktop/Coursework

# ── Optional ──────────────────────────────────────────────────────────────────
# Where canvas_config.json (course list, folder names) lives. Default: next to
# this checkout. Put it inside the coursework folder when that is what persists
# between runs (the cloud setup does this).
#CANVAS_CONFIG_FILE=~/hbs-coursework-2026/claude/canvas_config.json

# apple = Calendar.app via AppleScript (default on a Mac); ics = write a
# subscribable canvas.ics feed instead (default elsewhere); none = skip.
#CALENDAR_BACKEND=ics

# Cap NotebookLM podcasts per run (0 = no cap).
#PODCAST_MAX_PER_RUN=4

# For ./setup.sh --mirror: the data-repo clone and the folder to mirror into.
#MIRROR_CLONE=~/hbs-coursework-2026
#MIRROR_DEST=~/Library/Mobile Documents/com~apple~CloudDocs/HBS/Classes/2026
